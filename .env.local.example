# PostgreSQL connection (Neon, Supabase, or any Postgres).
# Leave DATABASE_URL unset to run the app on built-in demo data.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# TLS is verified by default. Override only if you must:
#   PGSSL=disable     -> no TLS (e.g. local Postgres)
#   PGSSL=no-verify   -> TLS without certificate verification (self-signed certs)
# PGSSL=
